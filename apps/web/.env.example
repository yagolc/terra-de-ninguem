# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings > API). Serve a chave "anon" ou a "publishable" (sb_publishable_...).
# Ela é pública por design: a segurança vem do RLS. NUNCA coloque a service role aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# Loja de gemas: conta que recebe o Pix (chave, nome do titular e cidade, como no app do banco).
# Configure também no painel da Vercel. Sem as três, a loja aparece fechada.
VITE_PIX_CHAVE=sua-chave-pix
VITE_PIX_NOME=Seu Nome
VITE_PIX_CIDADE=Sua Cidade
